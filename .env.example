NODE_ENV=development
HOST=127.0.0.1
# Required when HOST is 0.0.0.0 or ::. Comma-separated host names accepted by the MCP endpoint.
# MCP_ALLOWED_HOSTS=linkcli.example.internal,127.0.0.1
PORT=3000
DATABASE_URL=mysql://linkcli:replace-me@127.0.0.1:3306/linkcli
ADMIN_API_KEY=replace-with-at-least-24-characters
# 32 random bytes encoded as base64. Generate once and store in the deployment secret manager.
PROJECT_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key
PROJECT_CREDENTIAL_KEY_ID=v1
# Independent, stable 32-byte HMAC key for deterministic question and turn fingerprints. Rotating it requires a fingerprint migration.
COLLECTION_FINGERPRINT_KEY=replace-with-another-base64-encoded-32-byte-key
MCP_CALL_TIMEOUT_MS=30000
HEALTH_FAILURE_THRESHOLD=3
HEALTH_RECOVERY_THRESHOLD=2
HEALTH_STALE_AFTER_MS=120000
# L3 only consumes complete settled turns written by L2; it never clusters individual live calls.
L3_BATCH_ENABLED=true
L3_BATCH_INTERVAL_MS=300000
L3_BATCH_SIZE=1000
L3_MINIMUM_SAMPLES=20
L3_MINIMUM_ACTORS=5
L3_MINIMUM_SPAN_MS=259200000
L3_MINIMUM_INPUT_COMPLETENESS=0.95
L3_MINIMUM_COHESION=0.82
L3_MINIMUM_SUCCESS_RATE=0.9
L3_MINIMUM_COVERAGE_GAPS=5
L3_MINIMUM_COVERAGE_GAP_RATIO=0.2
# Embedding only recalls Top-K candidates inside the deterministic bucket. It does not make the final category decision.
L3_RECALL_TOP_K=5
L3_REPRESENTATIVE_QUERY_LIMIT=3
L3_MINIMUM_RECALL_SIMILARITY=0
L3_MINIMUM_REBUILD_MEMBERS=3
L3_REBUILD_INTERVAL_MS=1800000
# Keep false until both embedding recall and the LLM judge have passed labeled-data evaluation.
L3_CANDIDATE_HANDOFF_ENABLED=false
# Configure all four values together for production semantic clustering. If omitted, L3 runs in shadow mode and never hands candidates to L4.
# L3_EMBEDDING_ENDPOINT=https://example.internal/v1/embeddings
# L3_EMBEDDING_API_KEY=replace-with-secret-manager-value
# L3_EMBEDDING_MODEL=multilingual-embedding-model
# L3_EMBEDDING_DIMENSIONS=1024
# Instead of the four remote settings above, configure both local settings to run a Transformers.js ONNX model in process.
# L3_LOCAL_EMBEDDING_MODEL=Xenova/paraphrase-multilingual-MiniLM-L12-v2
# L3_LOCAL_EMBEDDING_DIMENSIONS=384
L3_LOCAL_EMBEDDING_DTYPE=q8
# L3_LOCAL_EMBEDDING_CACHE_DIR=/var/lib/linkcli/models
L3_LOCAL_EMBEDDING_LOCAL_FILES_ONLY=true
# Judge provider: shadow, remote, or codex-cli. codex-cli reuses the host Codex login and is intended for local experiments.
L3_JUDGE_PROVIDER=shadow
# Local Codex CLI Judge. The host must have the CLI installed and logged in; this model is not exposed through the public API.
L3_CODEX_CLI_COMMAND=codex
L3_CODEX_CLI_MODEL=gpt-5.3-codex-spark
L3_CODEX_CLI_REASONING_EFFORT=medium
L3_CODEX_CLI_TIMEOUT_MS=60000
# OpenAI Chat Completions compatible remote LLM used when L3_JUDGE_PROVIDER=remote. MiniLM cannot replace this judge.
# L3_LLM_ENDPOINT=https://example.internal/v1/chat/completions
# L3_LLM_API_KEY=replace-with-secret-manager-value
# L3_LLM_MODEL=cluster-judge-model
COLLECTION_IDLE_TIMEOUT_MS=300000
COLLECTION_GRACE_PERIOD_MS=60000
COLLECTION_LATE_REVISION_MS=86400000
COLLECTION_MAX_CALLS_PER_TURN=100
COLLECTION_WORKER_INTERVAL_MS=1000
COLLECTION_WORKER_BATCH_SIZE=100
COLLECTION_LEASE_MS=30000
COLLECTION_MAX_DELIVERY_ATTEMPTS=10
COLLECTION_STARTED_CALL_TIMEOUT_MS=120000
COLLECTION_DETAIL_RETENTION_DAYS=90
COLLECTION_OUTBOX_RETENTION_DAYS=7
# Optional L4/operations event webhook for tool suspension, restoration, publication, health, and stale-review alerts.
# L4_EVENT_ENDPOINT=https://automation.example.internal/v1/linkcli-events
