{
  "name": "linkcli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx --env-file=.env watch src/main.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "build": "npm run build:api && npm run build:web",
    "build:api": "tsc -p tsconfig.build.json",
    "build:web": "vite build --config web/vite.config.ts",
    "db:init": "node scripts/db/apply-schema.mjs",
    "db:upgrade:console": "node scripts/db/apply-console-schema.mjs",
    "db:upgrade:analysis": "node scripts/db/apply-analysis-schema.mjs",
    "admin:bootstrap": "node scripts/admin/bootstrap-operator.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "typecheck:web": "tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:mysql": "vitest run --no-file-parallelism tests/mysql-e2e.integration.test.ts tests/mysql-analysis.integration.test.ts",
    "eval:l3": "tsx scripts/analysis/evaluate-l3-clustering.ts",
    "eval:l3:codex-smoke": "tsx scripts/analysis/smoke-codex-cli-judge.ts",
    "check": "npm run typecheck && npm run typecheck:web && npm test && npm run build",
    "spec": "python3 scripts/spec/flow_guard.py"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@huggingface/transformers": "^3.8.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "@phosphor-icons/react": "^2.1.10",
    "@tanstack/react-query": "^5.90.20",
    "argon2": "^0.44.0",
    "express": "5.1.0",
    "gsap": "^3.13.0",
    "mysql2": "3.14.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.13.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.1.18",
    "@types/express": "5.0.3",
    "@types/node": "22.18.0",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.18",
    "tsx": "4.20.5",
    "typescript": "5.9.2",
    "vite": "^7.3.1",
    "vitest": "3.2.4"
  }
}
